<hc:Window
    x:Class="RotdToolkit2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:RotdToolkit2"
    Title="死亡之路2 · 工具箱"
    Width="1020"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    d:DesignHeight="720"
    d:DesignWidth="1020"
    Style="{StaticResource WindowWin10}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <hc:Window.Resources>
        <SolidColorBrush x:Key="LabelBrush" Color="#B3B3B3" />
        <SolidColorBrush x:Key="FaintBrush" Color="#9E9E9E" />
        <SolidColorBrush x:Key="NavSeparatorBrush" Color="#2A2A2A" />

        <local:HighlightConverter x:Key="Highlight" />
        <local:StateToBrushConverter x:Key="StateBrush" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="PageSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SideGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ArrowGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="BoolFieldTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{StaticResource FaintBrush}"
                        Text="{Binding Name}" />
                </StackPanel>
                <ToggleButton
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding BoolValue, Mode=TwoWay}"
                    Style="{StaticResource ToggleButtonSwitch}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NumberFieldTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{StaticResource FaintBrush}"
                        Text="{Binding Name}" />
                </StackPanel>
                <TextBox
                    Grid.Column="1"
                    Width="160"
                    HorizontalAlignment="Left"
                    Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OtherFieldTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="10"
                        Foreground="{StaticResource FaintBrush}"
                        Text="{Binding Name}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource LabelBrush}"
                    Text="{Binding OtherText}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <local:FieldTemplateSelector
            x:Key="FieldSelector"
            BoolTemplate="{StaticResource BoolFieldTemplate}"
            NumberTemplate="{StaticResource NumberFieldTemplate}"
            OtherTemplate="{StaticResource OtherFieldTemplate}" />
    </hc:Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  侧边导航（HandyControl 样式化的 ListBox，宽度固定避免文字截断）  -->
        <ListBox
            x:Name="Nav"
            Grid.Column="0"
            Width="168"
            Background="{DynamicResource RegionBrush}"
            BorderBrush="{StaticResource NavSeparatorBrush}"
            BorderThickness="0,0,1,0"
            SelectedIndex="0"
            SelectionChanged="OnNavSelectionChanged">
            <ListBoxItem Padding="16,11">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SideGlyph}" Text="&#xE895;" />
                    <TextBlock
                        Margin="12,0,0,0"
                        Text="同步"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Padding="16,11">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SideGlyph}" Text="&#xE7FC;" />
                    <TextBlock
                        Margin="12,0,0,0"
                        Text="作弊"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Padding="16,11">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SideGlyph}" Text="&#xE70F;" />
                    <TextBlock
                        Margin="12,0,0,0"
                        Text="存档"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem Padding="16,11">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SideGlyph}" Text="&#xE8C8;" />
                    <TextBlock
                        Margin="12,0,0,0"
                        Text="备份"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!--  内容  -->
        <Grid Grid.Column="1" Margin="28,20,28,20">

            <!--  同步  -->
            <Grid x:Name="PanelSync">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="同步存档" />
                        <TextBlock Style="{StaticResource PageSub}" Text="在 U77 汉化版与 SWF 版之间互转。差异项会高亮，同步前需确认。" />
                    </StackPanel>
                    <Button
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="OnRefresh"
                        Content="刷新"
                        Style="{StaticResource ButtonDefault}" />
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    VerticalAlignment="Top">

                    <!--  对比表  -->
                    <hc:Card Padding="0">
                        <Border Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  表头  -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Text="{Binding CnSlot.Label}"
                                            VerticalAlignment="Center" />
                                        <hc:Tag
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding CnSlot.StateText, Converter={StaticResource StateBrush}}"
                                            Content="{Binding CnSlot.StateText}"
                                            Foreground="White"
                                            ShowCloseButton="False" />
                                        <hc:Tag
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding CnTimeTag}"
                                            ShowCloseButton="False" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Text="{Binding EnSlot.Label}"
                                            VerticalAlignment="Center" />
                                        <hc:Tag
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding EnSlot.StateText, Converter={StaticResource StateBrush}}"
                                            Content="{Binding EnSlot.StateText}"
                                            Foreground="White"
                                            ShowCloseButton="False" />
                                        <hc:Tag
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding EnTimeTag}"
                                            ShowCloseButton="False" />
                                    </StackPanel>
                                </StackPanel>

                                <hc:Divider
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Margin="0,14" />

                                <!--  金钱  -->
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="金钱" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,16,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding CnSlot.MoneyText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="CnSlot.Money" />
                                            <Binding Path="EnSlot.Money" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding EnSlot.MoneyText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="EnSlot.Money" />
                                            <Binding Path="CnSlot.Money" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <!--  剧情  -->
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="剧情" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,16,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding CnSlot.StoryText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="CnSlot.Story" />
                                            <Binding Path="EnSlot.Story" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="2"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding EnSlot.StoryText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="EnSlot.Story" />
                                            <Binding Path="CnSlot.Story" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <!--  改装  -->
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="改装" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,0,16,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding CnSlot.UpgradesText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="CnSlot.Upgrades" />
                                            <Binding Path="EnSlot.Upgrades" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding EnSlot.UpgradesText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="EnSlot.Upgrades" />
                                            <Binding Path="CnSlot.Upgrades" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <!--  成就  -->
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="成就" />
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Margin="0,0,16,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding CnSlot.AchievementText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="CnSlot.Achieved" />
                                            <Binding Path="EnSlot.Achieved" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="5"
                                    Grid.Column="2"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding EnSlot.AchievementText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="EnSlot.Achieved" />
                                            <Binding Path="CnSlot.Achieved" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <!--  统计  -->
                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="统计" />
                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,0,16,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding CnSlot.StatsText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="CnSlot.Killed" />
                                            <Binding Path="EnSlot.Killed" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="6"
                                    Grid.Column="2"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowValue}"
                                    Text="{Binding EnSlot.StatsText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="EnSlot.Killed" />
                                            <Binding Path="CnSlot.Killed" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>

                                <!--  文件  -->
                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="文件" />
                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Margin="0,0,16,12"
                                    Style="{StaticResource RowValue}"
                                    ToolTip="{Binding CnSlot.ModifiedFullText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="CnSlot.Modified" />
                                            <Binding Path="EnSlot.Modified" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                    <Run Text="{Binding CnSlot.SizeText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding CnSlot.RelativeTimeText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="2"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowValue}"
                                    ToolTip="{Binding EnSlot.ModifiedFullText}">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource Highlight}">
                                            <Binding Path="EnSlot.Modified" />
                                            <Binding Path="CnSlot.Modified" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                    <Run Text="{Binding EnSlot.SizeText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding EnSlot.RelativeTimeText, Mode=OneWay}" />
                                </TextBlock>

                                <!--  位置  -->
                                <TextBlock
                                    Grid.Row="8"
                                    Grid.Column="0"
                                    Margin="0,0,0,12"
                                    Style="{StaticResource RowLabel}"
                                    Text="位置" />
                                <Grid Grid.Row="8" Grid.Column="1" Margin="0,0,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontFamily="Consolas"
                                        FontSize="10.5"
                                        Foreground="{StaticResource FaintBrush}"
                                        Text="{Binding CnSlot.Path}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding CnSlot.Path}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="8,2"
                                        Click="OnCopyPath"
                                        Content="复制"
                                        Style="{StaticResource ButtonDefault}"
                                        Tag="{Binding CnSlot}" />
                                </Grid>
                                <Grid Grid.Row="8" Grid.Column="2" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontFamily="Consolas"
                                        FontSize="10.5"
                                        Foreground="{StaticResource FaintBrush}"
                                        Text="{Binding EnSlot.Path}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding EnSlot.Path}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Padding="8,2"
                                        Click="OnCopyPath"
                                        Content="复制"
                                        Style="{StaticResource ButtonDefault}"
                                        Tag="{Binding EnSlot}" />
                                </Grid>

                                <hc:Divider
                                    Grid.Row="9"
                                    Grid.ColumnSpan="3"
                                    Margin="0,4,0,14" />

                                <!--  同步操作（两侧同款按钮，方向图标统一在文字右侧）  -->
                                <Button
                                    Grid.Row="10"
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    HorizontalAlignment="Left"
                                    Click="OnOverwriteSlot"
                                    Style="{StaticResource ButtonPrimary}"
                                    Tag="{Binding CnSlot}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CnSlot.OverwriteLabel}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ArrowGlyph}"
                                            Text="&#xE72A;" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Row="10"
                                    Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    Click="OnOverwriteSlot"
                                    Style="{StaticResource ButtonPrimary}"
                                    Tag="{Binding EnSlot}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EnSlot.OverwriteLabel}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ArrowGlyph}"
                                            Text="&#xE72B;" />
                                    </StackPanel>
                                </Button>

                                <TextBlock
                                    Grid.Row="11"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,14,0,0"
                                    FontSize="12"
                                    Foreground="{StaticResource FaintBrush}"
                                    Text="{Binding SyncHint}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </hc:Card>

                    <!--  同步选项  -->
                    <hc:Card Margin="0,14,0,0" Padding="0">
                        <Border Padding="20,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton
                                        x:Name="ChkSyncAutoBackup"
                                        VerticalAlignment="Center"
                                        IsChecked="True"
                                        Style="{StaticResource ToggleButtonSwitch}" />
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock
                                            Text="覆盖前自动备份"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{StaticResource FaintBrush}"
                                            Text="同步前先把目标存档打包备份，可随时在「备份」页还原。" />
                                    </StackPanel>
                                </StackPanel>
                                <Button
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="OnGoBackup"
                                    Content="查看备份"
                                    Style="{StaticResource ButtonDefault}" />
                            </Grid>
                        </Border>
                    </hc:Card>
                </StackPanel>
            </Grid>

            <!--  作弊  -->
            <Grid x:Name="PanelCheat" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource PageTitle}" Text="作弊" />
                    <TextBlock Style="{StaticResource PageSub}" Text="运行时内存修改，不改游戏文件。游戏启动后自动连接与定位。" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,0,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <hc:Card Margin="0,16,0,0" Padding="0">
                            <Border Padding="16,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource PrimaryBrush}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        Text="{Binding CheatStatus}"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </hc:Card>

                        <hc:Divider
                            Content="需进入车内画面"
                            Margin="0,22,0,6"
                            FontSize="12.5"
                            Foreground="{StaticResource LabelBrush}" />

                        <hc:Card Padding="0">
                            <Border Padding="18,6">
                                <StackPanel>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="无敌" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="开启后车辆不会损毁" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogGod"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnGodToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnGodToggle" />
                                    </Grid>

                                    <hc:Divider Margin="0" />

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="最大速度" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="持续保持最高车速" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogSpeed"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnSpeedToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnSpeedToggle" />
                                    </Grid>

                                    <hc:Divider Margin="0" />

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C8;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="无限子弹" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="弹匣与备弹始终充足" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogAmmo"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnAmmoToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnAmmoToggle" />
                                    </Grid>

                                    <hc:Divider Margin="0" />

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7EE;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="一击必杀" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="敌人一碰即死 / 一枪毙命" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogOneHit"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnOneHitToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnOneHitToggle" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </hc:Card>

                        <hc:Divider
                            Content="主菜单即可"
                            Margin="0,22,0,6"
                            FontSize="12.5"
                            Foreground="{StaticResource LabelBrush}" />

                        <hc:Card Padding="0">
                            <Border Padding="18,6">
                                <StackPanel>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE1D6;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="无限金钱" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="金钱保持充足" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogMoney"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnMoneyToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnMoneyToggle" />
                                    </Grid>

                                    <hc:Divider Margin="0" />

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE90F;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="满改装" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="所有改装配件升满" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogMaxUp"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnMaxUpToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnMaxUpToggle" />
                                    </Grid>

                                    <hc:Divider Margin="0" />

                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingTitle}" Text="剧情全解锁" />
                                            <TextBlock Style="{StaticResource SettingDesc}" Text="解锁全部剧情关卡" />
                                        </StackPanel>
                                        <ToggleButton
                                            x:Name="TogUnlock"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Checked="OnUnlockToggle"
                                            IsEnabled="{Binding CheatAvailable}"
                                            Style="{StaticResource ToggleButtonSwitch}"
                                            Unchecked="OnUnlockToggle" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </hc:Card>

                        <hc:Divider
                            Content="其它"
                            Margin="0,22,0,6"
                            FontSize="12.5"
                            Foreground="{StaticResource LabelBrush}" />

                        <hc:Card Padding="0">
                            <Border Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Style="{StaticResource Glyph}"
                                        Text="&#xE74D;" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource SettingTitle}" Text="全部关闭" />
                                        <TextBlock Style="{StaticResource SettingDesc}" Text="立即撤销所有已开启效果" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="OnCheatOff"
                                        Content="关闭全部"
                                        Style="{StaticResource ButtonDanger}" />
                                </Grid>
                            </Border>
                        </hc:Card>

                        <TextBlock
                            Margin="0,12,0,0"
                            FontSize="12"
                            Foreground="{StaticResource FaintBrush}"
                            TextWrapping="Wrap"
                            Text="金钱 / 满改装 / 解锁 主菜单即可；无敌 / 最大速度 / 无限子弹 / 一击必杀 需进入车内画面。" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  存档编辑  -->
            <Grid x:Name="PanelEdit" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource PageTitle}" Text="存档编辑" />
                    <TextBlock Style="{StaticResource PageSub}" Text="直接修改 RoadOfTheDead2_Beta1.sol 字段，保存前可自动备份。" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,8,0"
                        Text="对象"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryTextBrush}" />
                    <ComboBox
                        x:Name="CmbEditSide"
                        Width="280"
                        Margin="0,0,8,0"
                        SelectionChanged="OnEditSideChanged" />
                    <Button
                        Click="OnLoadForEdit"
                        Content="加载"
                        Style="{StaticResource ButtonPrimary}" />
                    <ToggleButton
                        x:Name="ChkAutoBackup"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="True"
                        Style="{StaticResource ToggleButtonSwitch}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        Text="保存前自动备份"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource LabelBrush}" />
                </StackPanel>

                <ScrollViewer
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <hc:Card Padding="0">
                        <Border Padding="16">
                            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplateSelector="{StaticResource FieldSelector}" />
                        </Border>
                    </hc:Card>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Click="OnReloadForEdit"
                        Content="放弃"
                        Style="{StaticResource ButtonDefault}" />
                    <Button
                        Click="OnApplyEdit"
                        Content="保存"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Grid>

            <!--  备份  -->
            <Grid x:Name="PanelBackup" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource PageTitle}" Text="备份" />
                    <TextBlock Style="{StaticResource PageSub}" Text="打包备份 ROTD2 存档，可随时还原。" />
                </StackPanel>

                <hc:Card Grid.Row="1" Margin="0,16,0,0" Padding="0">
                    <Border Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding BackupRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Click="OnBrowseBackupRoot"
                                Content="浏览"
                                Style="{StaticResource ButtonDefault}" />
                            <Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Click="OnCreateBackup"
                                Content="立即备份"
                                Style="{StaticResource ButtonPrimary}" />
                        </Grid>
                    </Border>
                </hc:Card>

                <ListBox
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    DisplayMemberPath="Display"
                    ItemsSource="{Binding Backups}"
                    SelectedItem="{Binding SelectedBackup, Mode=TwoWay}" />

                <StackPanel
                    Grid.Row="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Click="OnRestoreBackup"
                        Content="还原"
                        Style="{StaticResource ButtonPrimary}" />
                    <Button
                        Margin="0,0,8,0"
                        Click="OnDeleteBackup"
                        Content="删除"
                        Style="{StaticResource ButtonDanger}" />
                    <Button
                        Margin="0,0,8,0"
                        Click="OnOpenBackupRoot"
                        Content="打开目录"
                        Style="{StaticResource ButtonDefault}" />
                    <Button
                        Click="OnRefreshBackups"
                        Content="刷新"
                        Style="{StaticResource ButtonDefault}" />
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</hc:Window>
